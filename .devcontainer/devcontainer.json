{
  "name": "ETEC · ambiente de testes",
  "dockerComposeFile": "compose.yaml",
  "service": "site",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "remoteEnv": {"ETEC_CODESPACES_TESTE": "1"},
  "forwardPorts": [5000],
  "portsAttributes": {"5000": {"label": "ETEC · site de testes", "onAutoForward": "notify", "protocol": "http"}},
  "postCreateCommand": "python -m pip install -r requirements.txt && python .devcontainer/ambiente.py preparar",
  "postStartCommand": "python .devcontainer/ambiente.py iniciar",
  "shutdownAction": "stopCompose"
}
